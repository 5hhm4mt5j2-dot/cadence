# Copy this file to `.env.local` and fill in the value.
# `.env.local` is gitignored (via *.local) so your key is never committed.

# USDA FoodData Central API key — free signup, ~instant:
#   https://fdc.nal.usda.gov/api-key-signup
# Used for meal text search and photo-recognition ingredient lookup.
# Embedded at build time by Vite, so it must be present before `npm run build`.
VITE_USDA_API_KEY=
